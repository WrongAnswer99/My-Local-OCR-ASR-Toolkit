# 第三方预编译依赖（paddle_inference、opencv 等体积很大，不入库）
.source/

# 下载的推理模型
models/

# 构建产物
build/
build-*/
*.exe
*.zip
*.dll
*.lib
*.a
*.obj
*.o
*.pdb
*.ilk

# 待分发目录(体积大, 不入库; 用 tools/make_dist.ps1 生成)
dist/
dist-*/
__pycache__/
*.py[cod]

# 在 sdk/examples 里本地试运行 example/api_demo 时复制来的运行库与模型
sdk/examples/*.dll
sdk/examples/models/

# 第三方库
third_party/

# IDE
.vs/
.vscode/

# 图片
images/

